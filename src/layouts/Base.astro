---
import Analytics from '@vercel/analytics/astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
    title?: string;
}

const { title = 'DAF Commons — Collective Infrastructure for Impact' } = Astro.props;
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content="Building collective infrastructure to unlock $50B+ in impact investments from the donor-advised fund ecosystem">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <meta property="og:title" content={title}>
    <meta property="og:description" content="Building collective infrastructure to unlock $50B+ in impact investments from the donor-advised fund ecosystem">
    <meta property="og:image" content="/og-image.png">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content="Building collective infrastructure to unlock $50B+ in impact investments from the donor-advised fund ecosystem">
    <meta name="twitter:image" content="/og-image.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <div class="bg-texture bg-texture-1"></div>
    <div class="bg-texture bg-texture-2"></div>

    <Nav />

    <main>
        <slot />
    </main>

    <Footer />

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="/scripts/supabase.js"></script>
    <script is:inline src="/scripts/dynamic-lists.js"></script>
    <script is:inline src="/scripts/copy-email.js"></script>
    <script is:inline src="/scripts/animations.js"></script>
    <Analytics />
</body>
</html>
