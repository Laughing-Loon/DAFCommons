---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
    title?: string;
}

const { title = 'DAF Commons — Collective Infrastructure for Impact' } = Astro.props;
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
    <div class="bg-texture bg-texture-1"></div>
    <div class="bg-texture bg-texture-2"></div>

    <Nav />

    <main>
        <slot />
    </main>

    <Footer />

    <script is:inline src="/scripts/supabase.js"></script>
    <script is:inline src="/scripts/animations.js"></script>
</body>
</html>
