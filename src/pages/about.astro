---
import Base from '../layouts/Base.astro';
---
<Base title="About — DAF Commons">
    <div class="page">
        <section class="hero">
            <div class="container">
                <div class="hero-content scroll-animate">
                    <h1 class="huge accent" data-content="about_hero_heading">About DAF Commons</h1>
                    <p class="body-large hero-subtitle" data-content="about_hero_subtitle">
                        Who we are, what we do, and why we believe the DAF ecosystem can do more — together.
                    </p>
                </div>
            </div>
        </section>
        <section class="section">
            <div class="container">
                <!-- Who We Are -->
                <div class="about-text-block scroll-animate">
                    <div class="about-label" data-content="about_who_label">Who We Are</div>
                    <p class="about-body" data-content="about_who_body">
                        We are a collective of individuals and practitioners frustrated by today's use of DAFs, and inspired by what's possible.
                    </p>
                    <div class="team-grid">
                        <div class="team-card scroll-animate">
                            <img class="team-photo" data-src="about_team_1_photo" src="" alt="">
                            <div class="team-name" data-content="about_team_1_name">Team Member 1</div>
                            <div class="team-role" data-content="about_team_1_role">Role</div>
                            <p class="team-description" data-content="about_team_1_description">Description coming soon.</p>
                            <a class="team-linkedin" data-href="about_team_1_linkedin" href="#" target="_blank" rel="noopener" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                        <div class="team-card scroll-animate">
                            <img class="team-photo" data-src="about_team_2_photo" src="" alt="">
                            <div class="team-name" data-content="about_team_2_name">Team Member 2</div>
                            <div class="team-role" data-content="about_team_2_role">Role</div>
                            <p class="team-description" data-content="about_team_2_description">Description coming soon.</p>
                            <a class="team-linkedin" data-href="about_team_2_linkedin" href="#" target="_blank" rel="noopener" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                        <div class="team-card scroll-animate">
                            <img class="team-photo" data-src="about_team_3_photo" src="" alt="">
                            <div class="team-name" data-content="about_team_3_name">Team Member 3</div>
                            <div class="team-role" data-content="about_team_3_role">Role</div>
                            <p class="team-description" data-content="about_team_3_description">Description coming soon.</p>
                            <a class="team-linkedin" data-href="about_team_3_linkedin" href="#" target="_blank" rel="noopener" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                        <div class="team-card scroll-animate">
                            <img class="team-photo" data-src="about_team_4_photo" src="" alt="">
                            <div class="team-name" data-content="about_team_4_name">Team Member 4</div>
                            <div class="team-role" data-content="about_team_4_role">Role</div>
                            <p class="team-description" data-content="about_team_4_description">Description coming soon.</p>
                            <a class="team-linkedin" data-href="about_team_4_linkedin" href="#" target="_blank" rel="noopener" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                        <div class="team-card scroll-animate">
                            <img class="team-photo" data-src="about_team_5_photo" src="" alt="">
                            <div class="team-name" data-content="about_team_5_name">Team Member 5</div>
                            <div class="team-role" data-content="about_team_5_role">Role</div>
                            <p class="team-description" data-content="about_team_5_description">Description coming soon.</p>
                            <a class="team-linkedin" data-href="about_team_5_linkedin" href="#" target="_blank" rel="noopener" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                        <div class="team-card scroll-animate">
                            <img class="team-photo" data-src="about_team_6_photo" src="" alt="">
                            <div class="team-name" data-content="about_team_6_name">Team Member 6</div>
                            <div class="team-role" data-content="about_team_6_role">Role</div>
                            <p class="team-description" data-content="about_team_6_description">Description coming soon.</p>
                            <a class="team-linkedin" data-href="about_team_6_linkedin" href="#" target="_blank" rel="noopener" aria-label="LinkedIn">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- What We Do -->
                <div class="rock-overlay" style="padding-top: 0;">
                    <div class="about-text-block scroll-animate">
                        <div class="about-label" data-content="about_what_label">What We Do</div>
                        <p class="about-body" data-content="about_what_body">
                            The DAF Commons project was born out of this frustration, and desire to build a collective space for DAF holders seeking to make material impact with their capital. DAF Commons serves as the connective tissue between DAF holders and DAF possibilities.
                        </p>
                    </div>
                </div>

                <!-- Collaborators -->
                <div class="about-text-block scroll-animate">
                    <div class="about-label" data-content="about_collab_label">Our Collaborators</div>
                    <p class="about-body" style="margin-bottom: clamp(24px, 4vw, 32px);" data-content="about_collab_intro">
                        This project's work is made possible with the support of:
                    </p>
                    <div class="collaborator-grid">
                        <div class="collaborator-card scroll-animate">
                            <img class="collaborator-logo" data-src="about_collab_1_logo" src="" alt="CataCap">
                            <div class="collaborator-name" data-content="about_collab_1">CataCap</div>
                        </div>
                        <div class="collaborator-card scroll-animate">
                            <img class="collaborator-logo" data-src="about_collab_2_logo" src="" alt="Sea Forward Fund">
                            <div class="collaborator-name" data-content="about_collab_2">Sea Forward Fund</div>
                        </div>
                        <div class="collaborator-card scroll-animate">
                            <img class="collaborator-logo" data-src="about_collab_3_logo" src="" alt="Collective Climate Justice Fund">
                            <div class="collaborator-name" data-content="about_collab_3">Collective Climate Justice Fund</div>
                        </div>
                    </div>
                </div>

                <!-- FAQ -->
                <div class="scroll-animate" style="margin-top: clamp(64px, 10vw, 120px);">
                    <div class="about-label" style="margin-bottom: clamp(24px, 4vw, 32px);" data-content="about_faq_label">Frequently Asked Questions</div>
                    <div class="faq-list">
                        <div class="faq-item">
                            <button class="faq-question" data-faq-toggle>
                                <span data-content="about_faq_1_question">FAQ question 1</span>
                                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <div class="faq-answer"><div class="faq-answer-inner" data-content="about_faq_1_answer">Answer 1</div></div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question" data-faq-toggle>
                                <span data-content="about_faq_2_question">FAQ question 2</span>
                                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <div class="faq-answer"><div class="faq-answer-inner" data-content="about_faq_2_answer">Answer 2</div></div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question" data-faq-toggle>
                                <span data-content="about_faq_3_question">FAQ question 3</span>
                                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <div class="faq-answer"><div class="faq-answer-inner" data-content="about_faq_3_answer">Answer 3</div></div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question" data-faq-toggle>
                                <span data-content="about_faq_4_question">FAQ question 4</span>
                                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <div class="faq-answer"><div class="faq-answer-inner" data-content="about_faq_4_answer">Answer 4</div></div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question" data-faq-toggle>
                                <span data-content="about_faq_5_question">FAQ question 5</span>
                                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <div class="faq-answer"><div class="faq-answer-inner" data-content="about_faq_5_answer">Answer 5</div></div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question" data-faq-toggle>
                                <span data-content="about_faq_6_question">FAQ question 6</span>
                                <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            </button>
                            <div class="faq-answer"><div class="faq-answer-inner" data-content="about_faq_6_answer">Answer 6</div></div>
                        </div>
                    </div>
                </div>

                <!-- Contact -->
                <div class="contact-box scroll-animate">
                    <div class="about-label" style="margin-bottom: clamp(24px, 4vw, 32px);" data-content="about_contact_label">Contact</div>
                    <p class="body" style="margin-bottom: clamp(24px, 4vw, 32px); opacity: 0.7;" data-content="about_contact_intro">Reach out to us at</p>
                    <a href="mailto:connect@DAFCommons.earth" class="contact-email" data-content="about_contact_email">connect@DAFCommons.earth</a>
                </div>
            </div>
        </section>
    </div>
    <script is:inline>
        document.querySelectorAll('[data-faq-toggle]').forEach(btn => {
            btn.addEventListener('click', function() {
                this.closest('.faq-item').classList.toggle('open');
            });
        });
    </script>
</Base>
