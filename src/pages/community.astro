---
import Base from '../layouts/Base.astro';
---
<Base title="Community — DAF Commons">
    <div class="page">
        <section class="hero">
            <div class="container">
                <div class="hero-content scroll-animate">
                    <h1 class="huge accent" data-content="community_hero_heading">Network & Community</h1>
                    <p class="body-large hero-subtitle" data-content="community_hero_subtitle">Coming soon! We’re building a space for DAF holders to connect, learn, and collaborate.</p>
                    <p class="body-large hero-subtitle" style="opacity: 0.7;" data-content="community_hero_description">
                        Help us shape it — take a quick survey and tell us what you’d want from a community like this.
                    </p>
                </div>
                <div class="cta-card scroll-animate" style="max-width: 640px; margin-top: clamp(32px, 5vw, 48px);">
                    <h3 class="medium" data-content="home_cta_survey_heading">If you have a DAF or are DAF curious, take our survey</h3>
                    <p class="body form-intro" data-content="home_cta_survey_intro">We want to know:</p>
                    <ul class="clean-list">
                        <li data-content="home_cta_survey_item_1">How you’re using it</li>
                        <li data-content="home_cta_survey_item_2">What’s confusing</li>
                        <li data-content="home_cta_survey_item_3">What’s possible</li>
                        <li data-content="home_cta_survey_item_4">What you’re interested in learning</li>
                    </ul>
                    <a href="https://forms.gle/JgSMCAXpyBrmsxG1A" target="_blank" class="button btn-secondary">Take the Survey</a>
                </div>
            </div>
        </section>
    </div>
</Base>
