---
import Base from '../layouts/Base.astro';
// Stories, events: rendered client-side from Supabase by /scripts/dynamic-lists.js
---
<Base title="Community — DAF Commons">
    <div class="page community-page">

        <!-- HERO -->
        <section class="community-hero">
            <div class="container">
                <div class="hero-content scroll-animate">
                    <h1 class="huge accent">Community</h1>
                    <p class="body-large hero-subtitle">
                        The gathering space for our DAF community. Here, we share what we are writing, where to find DAF Commons community members in the wild.
                    </p>
                    <div class="hero-jump-row">
                        <a href="#stories" class="hero-jump">Stories</a>
                        <span class="hero-jump-sep">·</span>
                        <a href="#in-the-wild" class="hero-jump">Events</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 01 — STORIES -->
        <section id="stories" class="community-section">
            <div class="container">
                <div class="section-head scroll-animate">
                    <div class="eyebrow-line"><span class="eyebrow-num">01</span><span class="eyebrow-dot">·</span> Stories</div>
                    <h2 class="large">DAF holders<br><em>in the wild.</em></h2>
                    <p class="body-large section-sub">Stories from DAF Commoners about their journey with their DAF.</p>
                </div>

                <div class="event-list" id="storyList"></div>

                <p class="story-subscribe-prompt scroll-animate">
                    Want more? <a href="https://dafcommons.substack.com/" target="_blank" rel="noopener">Subscribe on Substack →</a>
                </p>
            </div>
        </section>

        <!-- SECTION 02 — IN THE WILD -->
        <section id="in-the-wild" class="community-section community-section-warm">
            <div class="container">
                <div class="section-head scroll-animate">
                    <div class="eyebrow-line"><span class="eyebrow-num">02</span><span class="eyebrow-dot">·</span> Events</div>
                    <h2 class="large">Where to find us,<br><em>and each other.</em></h2>
                    <p class="body-large section-sub">Find DAF Commons and other DAF holders at events across the world.</p>
                </div>

                <div class="event-list" id="eventList"></div>

                <p class="event-host-prompt scroll-animate">
                    Hosting something we should be at? <a href="mailto:DAFCommons@gmail.com?subject=Event%20suggestion">Tell us →</a>
                </p>
            </div>
        </section>

    </div>
</Base>
