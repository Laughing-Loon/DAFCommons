                    <div style="display:flex;align-items:center;gap:8px;font-size: 13px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:var(--daf-mid);"><div style="width:28px;height:2px;background:var(--accent);"></div>Capital flows out</div>
                    <div style="display:flex;align-items:center;gap:8px;font-size: 13px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:var(--daf-mid);"><div style="width:28px;height:2px;background:repeating-linear-gradient(90deg,var(--accent) 0,var(--accent) 4px,transparent 4px,transparent 8px);"></div>Returns to account</div>
                </div>
